{
  "name": "salvagewars-net",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // After you create the database (see README.md), add this block here:
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "salvagewars", "database_id": "PASTE-YOUR-DATABASE-ID" }
  // ]
}
